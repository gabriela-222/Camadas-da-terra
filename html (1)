<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Missão: Centro da Terra</title>
    <style>
        * { box-sizing: border-box; margin: 0; padding: 0; font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif; }
        body { background-color: #1a1a2e; color: #fff; display: flex; justify-content: center; align-items: center; height: 100vh; }
        .game-container { width: 100%; max-width: 600px; height: 450px; background-color: #16213e; border-radius: 12px; box-shadow: 0 8px 24px rgba(0,0,0,0.5); overflow: hidden; display: flex; flex-direction: column; position: relative; }
        .screen { display: none; flex-direction: column; justify-content: center; align-items: center; height: 100%; padding: 20px; text-align: center; }
        .screen.active { display: flex; }
        h1 { font-size: 2rem; margin-bottom: 15px; color: #4ecca3; }
        p { font-size: 1rem; margin-bottom: 25px; color: #ccc; line-height: 1.5; }
        button { background-color: #e94560; color: white; border: none; padding: 12px 24px; font-size: 1rem; font-weight: bold; border-radius: 6px; cursor: pointer; transition: background 0.3s; }
        button:hover { background-color: #d8345f; }
        
        #game-header { width: 100%; display: flex; justify-content: space-between; padding: 10px 15px; background: rgba(0,0,0,0.3); font-weight: bold; }
        #game-arena { position: relative; width: 100%; flex-grow: 1; overflow: hidden; }
        
        .crosta { background: linear-gradient(to bottom, #87CEEB 40%, #8B4513 40%); }
        .manto { background: linear-gradient(to bottom, #d35400, #c0392b); }
        .nucleo { background: radial-gradient(circle, #f1c40f, #d35400, #78281f); }

        #player { position: absolute; font-size: 2rem; bottom: 20px; left: 50px; transform: translate(-50%, -50%); }
        .item { position: absolute; font-size: 1.8rem; top: 40%; right: 150px; cursor: pointer; animation: pulse 1s infinite alternate; }
        
        @keyframes pulse {
            from { transform: scale(1); }
            to { transform: scale(1.2); }
        }

        #message-box { position: absolute; bottom: 10px; width: 100%; text-align: center; font-size: 0.85rem; background: rgba(0,0,0,0.6); padding: 5px; }

        #quiz-panel { position: absolute; top: 0; left: 0; width: 100%; height: 100%; background: rgba(22, 33, 62, 0.95); display: flex; flex-direction: column; justify-content: center; align-items: center; padding: 30px; z-index: 10; }
        #quiz-panel.hidden { display: none; }
        #question-text { font-size: 1.2rem; margin-bottom: 20px; color: #f1c40f; }
        #options-container { display: flex; flex-direction: column; gap: 10px; width: 100%; max-width: 400px; }
        .option-btn { background-color: #0f3460; border: 2px solid #4ecca3; padding: 10px; color: white; border-radius: 5px; cursor: pointer; }
        .option-btn:hover { background-color: #4ecca3; color: #1a1a2e; }
    </style>
</head>
<body>

    <div class="game-container">
        <!-- TELA INICIAL -->
        <div id="start-screen" class="screen active">
            <h1>🌍 Missão: Centro da Terra</h1>
            <p>Ajude o explorador a descer da superfície até o núcleo da Terra, passando pelas camadas do planeta e respondendo a desafios científicos!</p>
            <button onclick="startGame()">Iniciar Missão</button>
        </div>

        <!-- TELA DO JOGO -->
        <div id="game-screen" class="screen">
            <header id="game-header">
                <span id="phase-title">Fase 1: Crosta Terrestre</span>
                <span id="score-board">Cristais: <span id="crystal-count">0</span>/3</span>
            </header>

            <div id="game-arena" class="crosta">
                <div id="player">🧑‍🚀</div>
                <div id="objective-item" class="item" onclick="collectItem()" title="Clique para coletar!">💎</div>
                <div id="message-box">Use as setas para mover o robô e **clique no cristal** para coletá-lo!</div>
            </div>

            <!-- PAINEL DE QUIZ -->
            <div id="quiz-panel" class="hidden">
                <h3 id="question-text">Pergunta da Fase</h3>
                <div id="options-container"></div>
            </div>
        </div>

        <!-- TELA DE VITÓRIA -->
        <div id="win-screen" class="screen">
            <h1>🎉 Missão Cumprida!</h1>
            <p>Parabéns! Você chegou com sucesso ao centro da Terra e aprendeu tudo sobre as camadas do nosso planeta!</p>
            <button onclick="restartGame()">Jogar Novamente</button>
        </div>
    </div>

    <script>
        let currentPhase = 1;
        let crystalsCollected = 0;
        let playerX = 50;
        let playerY = 20;

        const phasesData = {
            1: {
                title: "Fase 1: A Crosta Terrestre",
                arenaClass: "crosta",
                itemSymbol: "💎",
                targetCount: 3,
                question: "Qual é a camada mais fina e externa da Terra, onde vivemos?",
                options: ["Manto Terrestre", "Crosta Terrestre", "Núcleo Externo"],
                correct: 1
            },
            2: {
                title: "Fase 2: O Manto",
                arenaClass: "manto",
                itemSymbol: "🔥",
                targetCount: 3,
                question: "Como se chama o material rochoso derretido e pastoso localizado no manto?",
                options: ["Magma", "Granito Sólido", "Água Fervendo"],
                correct: 0
            },
            3: {
                title: "Fase 3: O Núcleo",
                arenaClass: "nucleo",
                itemSymbol: "⭐",
                targetCount: 3,
                question: "Quais são os dois principais metais que formam o núcleo da Terra?",
                options: ["Ouro e Prata", "Ferro e Níquel", "Cobre e Alumínio"],
                correct: 1
            }
        };

        function startGame() {
            document.getElementById('start-screen').classList.remove('active');
            document.getElementById('game-screen').classList.add('active');
            loadPhase(1);
        }

        function restartGame() {
            document.getElementById('win-screen').classList.remove('active');
            document.getElementById('start-screen').classList.add('active');
            currentPhase = 1;
            crystalsCollected = 0;
        }

        function loadPhase(phaseNum) {
            currentPhase = phaseNum;
            crystalsCollected = 0;
            document.getElementById('crystal-count').textContent = crystalsCollected;

            const data = phasesData[phaseNum];
            document.getElementById('phase-title').textContent = data.title;
            document.getElementById('game-arena').className = "crosta";
            if(phaseNum === 2) document.getElementById('game-arena').className = "manto";
            if(phaseNum === 3) document.getElementById('game-arena').className = "nucleo";
            
            document.getElementById('objective-item').textContent = data.itemSymbol;
            moveItemRandomly();
        }

        function moveItemRandomly() {
            const item = document.getElementById('objective-item');
            const randomX = Math.floor(Math.random() * 60) + 20;
            const randomY = Math.floor(Math.random() * 50) + 20;
            item.style.left = randomX + '%';
            item.style.top = randomY + '%';
            item.style.display = 'block';
        }

        window.addEventListener('keydown', (e) => {
            const gameScreen = document.getElementById('game-screen');
            const quizPanel = document.getElementById('quiz-panel');
            if (!gameScreen.classList.contains('active') || !quizPanel.classList.contains('hidden')) return;

            const player = document.getElementById('player');
            const step = 6;
            if (e.key === 'ArrowRight' && playerX < 90) playerX += step;
            if (e.key === 'ArrowLeft' && playerX > 5) playerX -= step;
            if (e.key === 'ArrowUp' && playerY < 75) playerY += step;
            if (e.key === 'ArrowDown' && playerY > 10) playerY -= step;

            player.style.left = playerX + '%';
            player.style.bottom = playerY + '%';
        });

        function collectItem() {
            crystalsCollected++;
            document.getElementById('crystal-count').textContent = crystalsCollected;

            if (crystalsCollected < phasesData[currentPhase].targetCount) {
                moveItemRandomly();
            } else {
                document.getElementById('objective-item').style.display = 'none';
                triggerQuiz(currentPhase);
            }
        }

        function triggerQuiz(phaseNum) {
            const data = phasesData[phaseNum];
            document.getElementById('question-text').textContent = data.question;
            const container = document.getElementById('options-container');
            container.innerHTML = '';

            data.options.forEach((optText, idx) => {
                const btn = document.createElement('button');
                btn.textContent = optText;
                btn.className = 'option-btn';
                btn.onclick = () => checkAnswer(idx, data.correct);
                container.appendChild(btn);
            });

            document.getElementById('quiz-panel').classList.remove('hidden');
        }

        function checkAnswer(selected, correct) {
            if (selected === correct) {
                document.getElementById('quiz-panel').classList.add('hidden');
                if (currentPhase < 3) {
                    alert("Correto! Descendo para a próxima camada...");
                    loadPhase(currentPhase + 1);
                } else {
                    document.getElementById('game-screen').classList.remove('active');
                    document.getElementById('win-screen').classList.add('active');
                }
            } else {
                alert("Ops! Resposta incorreta. Tente novamente.");
            }
        }
    </script>
</body>
</html>